# Resolve and review this tag, then replace the marker with its registry digest.
# A mutable tag by itself is intentionally rejected by build_image.py.
CAT_TRAINER_BASE_IMAGE=verlai/verl:app-verl0.5-vllm0.9.1-mcore0.12.2-te2.2@sha256:REPLACE_WITH_REVIEWED_64_HEX_DIGEST

# After pushing the derived trainer image, use its registry manifest digest here.
CAT_TRAINER_IMAGE=registry.example/compute-as-a-teacher:paper-v1@sha256:REPLACE_WITH_TRAINER_64_HEX_DIGEST
CAT_TRAINER_IMAGE_DIGEST=sha256:REPLACE_WITH_TRAINER_64_HEX_DIGEST
