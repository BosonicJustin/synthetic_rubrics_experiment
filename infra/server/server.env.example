# Non-secret host and image contract. Replace every marker before use.
CAT_TRAINER_IMAGE=registry.example/compute-as-a-teacher@sha256:REPLACE_WITH_TRAINER_64_HEX_DIGEST
CAT_TRAINER_IMAGE_DIGEST=sha256:REPLACE_WITH_TRAINER_64_HEX_DIGEST
CAT_MODEL_REVISION=REPLACE_WITH_FULL_40_HEX_MODEL_COMMIT

CAT_ANCHOR_MODE=local
CAT_TRAINER_GPU_DEVICE_0=0
CAT_TRAINER_GPU_DEVICE_1=1
CAT_TRAINER_GPU_DEVICE_2=2
CAT_TRAINER_GPU_DEVICE_3=3
CAT_TRAINER_GPU_DEVICE_4=4
CAT_TRAINER_GPU_DEVICE_5=5
CAT_TRAINER_GPU_DEVICE_6=6
CAT_TRAINER_GPU_DEVICE_7=7
# Required only for local mode; remove this line for remote mode.
CAT_ANCHOR_GPU_DEVICE=8
# Required only while serving the trained export. It must differ from a local anchor GPU.
CAT_TRAINED_POLICY_GPU_DEVICE=0

CAT_MODEL_HOST_DIR=/srv/compute-as-a-teacher/models/REPLACE_WITH_FULL_40_HEX_MODEL_COMMIT
CAT_DATA_HOST_DIR=/srv/compute-as-a-teacher/data
CAT_OUTPUT_HOST_DIR=/srv/compute-as-a-teacher/outputs
CAT_CONFIG_HOST_DIR=/srv/compute-as-a-teacher/config
